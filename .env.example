# ---- Required -------------------------------------------------------------
DATABASE_URL=postgres://vms:change-me@localhost:5432/vms

# ---- Server ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Public URL of the application; embedded in visitor QR codes.
PUBLIC_BASE_URL=https://vms.example.org
# Behind a TLS-terminating reverse proxy: trust it for client IPs, and send
# cookies with the Secure flag (default true when NODE_ENV=production).
TRUST_PROXY=loopback
SECURE_COOKIES=true

# ---- Storage (photographs / logo; keep outside the web root, back it up) --
STORAGE_DIR=/var/lib/vms/storage
MAX_UPLOAD_BYTES=5242880

# ---- Rate limits ----------------------------------------------------------
LOGIN_RATE_LIMIT=20
API_RATE_LIMIT=600

# ---- Database -------------------------------------------------------------
DB_POOL_MAX=20
# Run migrations automatically at start-up (set false to run them manually).
AUTO_MIGRATE=true
# Overstay detection & notification dispatch jobs.
BACKGROUND_JOBS=true

# ---- E-mail notifications (optional) --------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- PDF font (optional; a Unicode TTF for names in any script) -----------
# PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# PDF_FONT_BOLD_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
